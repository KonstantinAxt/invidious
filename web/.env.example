# Base URL of the Invidious instance whose JSON API this frontend consumes.
# The repo's docker-compose.yml maps 127.0.0.1:3000:3000, but this dev machine's
# WhatsApp bridge already occupies 3000 — the local backend runs on 3001 via a
# throwaway compose file (see README "Running the backend").
INVIDIOUS_API_BASE_URL=http://localhost:3001
