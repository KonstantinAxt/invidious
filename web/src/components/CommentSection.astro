---
import type { ApiComment } from '../lib/api-types'
import { translate } from '../lib/i18n'
import { numberWithSeparator, shortNumber } from '../lib/numbers'
import Icon from './icons/Icon.astro'

interface Props {
  locale: string
  commentCount: number
  comments: { comment: ApiComment; avatarSrc: string | undefined }[]
}

const { locale, commentCount, comments } = Astro.props

const [commentsLabel, topLabel, newestLabel, replyLabel] = await Promise.all([
  translate(locale, 'Comments'),
  translate(locale, 'Top'),
  translate(locale, 'Newest'),
  translate(locale, 'Reply'),
])
---

<section class="comments">
  <header class="comments-header">
    <h2 class="comments-title">
      {commentsLabel} <span class="count">{numberWithSeparator(commentCount)}</span>
    </h2>
    <div class="sort-chips">
      <span class="chip selected">{topLabel}</span>
      <span class="chip">{newestLabel}</span>
    </div>
  </header>
  <ul>
    {comments.map(({ comment, avatarSrc }) => (
      <li>
        <article class="comment">
          <a class="avatar" href={comment.authorUrl} aria-label={comment.author}>
            {avatarSrc && <img src={avatarSrc} alt="" loading="lazy" />}
          </a>
          <div class="body">
            <div class="head">
              <a class="name" href={comment.authorUrl}>
                @{comment.author}
                {comment.verified && <Icon name="check" size={14} />}
              </a>
              <span class="time">{comment.publishedText}</span>
              <span class="more"><Icon name="more" size={24} /></span>
            </div>
            <div class="content" set:html={comment.contentHtml} />
            <div class="actions">
              <span class="pill">
                <span class="group">
                  <Icon name="like" size={24} />
                  {comment.likeCount > 0 && shortNumber(comment.likeCount)}
                </span>
                <span class="divider" />
                <Icon name="dislike" size={24} />
              </span>
              <span class="pill">
                <span class="group">
                  <Icon name="heart" size={24} />
                </span>
                <span class="divider" />
                <span class="reply-label">{replyLabel}</span>
              </span>
            </div>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .comments {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .comments-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-right: 8px;
  }

  .comments-title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    font-size: var(--font-size-title);
    font-weight: 500;
    color: var(--color-text);
  }

  .count {
    color: var(--color-text-muted);
    font-size: var(--font-size-title);
    font-weight: 400;
  }

  .sort-chips {
    display: flex;
    gap: 8px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 6px 16px;
    border: 1px solid var(--color-border-chip);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .chip.selected {
    background: #ffffff;
    border-color: transparent;
    color: #000000;
    padding: 6px 16px 6px 12px;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .comment {
    display: flex;
    gap: 12px;
  }

  .avatar {
    flex-shrink: 0;
    width: 43px;
    height: 43px;
    border-radius: 21.5px;
    overflow: hidden;
    background: #000000;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    min-width: 0;
    flex: 1;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .time {
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
  }

  .more {
    margin-left: auto;
    color: var(--color-text-secondary);
  }

  .content {
    margin-top: 10px;
    color: var(--color-text);
    font-size: var(--font-size-md);
    overflow-wrap: anywhere;
  }

  .content :global(a) {
    color: var(--color-link);
  }

  .actions {
    display: flex;
    gap: 20px;
    margin-top: 14px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    height: 32px;
    padding: 0 16px;
    border-radius: 100px;
    background: var(--color-fill-button);
    color: var(--color-text);
    font-size: var(--font-size-sm);
  }

  .group {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .divider {
    width: 1.286px;
    height: 28px;
    background: var(--color-border-hairline);
  }

  .reply-label {
    font-weight: 500;
  }
</style>
