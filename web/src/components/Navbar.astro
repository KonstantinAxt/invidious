---
import { translate } from '../lib/i18n'
import Icon from './icons/Icon.astro'
import SearchBox from './SearchBox.astro'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  locale: string
  query?: string
  showSearch?: boolean
}

const { locale, query, showSearch = true } = Astro.props
const [loginLabel, menuLabel] = await Promise.all([
  translate(locale, 'Log in'),
  translate(locale, 'menu'),
])
---

<header class="navbar">
  <div class="navbar-left">
    <button
      type="button"
      class="menu-btn"
      data-menu-toggle
      aria-label={menuLabel}
      aria-controls="app-sidebar"
    >
      <Icon name="menu" size={24} />
    </button>
    <a class="brand" href="/">
      <span class="brand-mark"><Icon name="youtube" size={24} /></span>
      <span class="brand-name">Invidious</span>
    </a>
  </div>
  {showSearch && <SearchBox locale={locale} query={query} />}
  <nav class="navbar-right">
    <ThemeToggle locale={locale} />
    <a class="login" href="/login">{loginLabel}</a>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  button?.addEventListener('click', () => {
    document.documentElement.classList.toggle('sidebar-open')
  })
</script>

<style>
  /* Mobile-first: one row, search pill auto-margined between the clusters.
     Desktop step matches the Figma nav: px-82, 727px search, 24px gaps. */
  .navbar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: var(--navbar-height);
    padding: 0 var(--space-4);
    background: var(--color-bg);
  }

  .navbar-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .menu-btn:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    color: var(--color-text);
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-mark {
    display: inline-flex;
    color: var(--color-accent-strong);
  }

  .brand-name {
    white-space: nowrap;
    font-weight: 500;
    font-size: 21px;
  }

  .navbar-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-shrink: 0;
  }

  .login {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-fill-button);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: 500;
    white-space: nowrap;
  }

  .login:hover {
    background: var(--color-surface-hover);
    text-decoration: none;
  }

  /* Very narrow screens: logo glyph only, like the YouTube mobile app. */
  @media (max-width: 479px) {
    .brand-name {
      display: none;
    }
  }

  /* 901px: never overlaps the mobile shell breakpoint (max-width: 900px). */
  @media (min-width: 901px) {
    .navbar {
      gap: var(--space-6);
      padding: 0 var(--page-margin);
    }

    .menu-btn {
      display: none;
    }

    .navbar-right {
      gap: 24px;
    }
  }
</style>
