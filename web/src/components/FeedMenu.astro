---
import { translate } from '../lib/i18n'
import { ROUTES } from '../lib/routes'

interface Props {
  locale: string
  items?: { labelKey: string; href: string }[]
}

const { locale, items } = Astro.props

const defaultItems = [
  { labelKey: 'Trending', href: ROUTES.trendingFeed },
  { labelKey: 'Popular', href: ROUTES.popularFeed },
]

const resolved = items ?? defaultItems
const labels = await Promise.all(resolved.map((item) => translate(locale, item.labelKey)))
---

<nav class="feed-menu">
  {resolved.map((item, index) => (
    <a href={item.href} class="feed-menu-item">{labels[index]}</a>
  ))}
</nav>

<style>
  .feed-menu {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .feed-menu-item {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .feed-menu-item:hover {
    background: var(--color-surface-hover);
    text-decoration: none;
  }
</style>
