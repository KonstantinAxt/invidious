---
import { isRtl, translate } from '../lib/i18n'
import Icon from './icons/Icon.astro'

interface Props {
  locale: string
  baseUrl: string
  currentPage?: number
  hasNext: boolean
  continuationToken?: string
}

const { locale, baseUrl, currentPage, hasNext, continuationToken } = Astro.props
const rtl = isRtl(locale)

const [prevPage, nextPage] = await Promise.all([
  translate(locale, 'Previous page'),
  translate(locale, 'Next page'),
])

const prevHref =
  currentPage !== undefined && currentPage > 1 ? `${baseUrl}&page=${currentPage - 1}` : null

let nextHref: string | null = null
if (hasNext) {
  if (currentPage !== undefined) {
    nextHref = `${baseUrl}&page=${currentPage + 1}`
  } else if (continuationToken) {
    nextHref = `${baseUrl}&continuation=${continuationToken}`
  }
}

const backArrow = rtl ? 'arrow-right' : 'arrow-left'
const forwardArrow = rtl ? 'arrow-left' : 'arrow-right'
---

<nav class="pagination">
  <div class="cluster">
    {prevHref ? (
      <a href={prevHref}><Icon name={backArrow} size={16} />{prevPage}</a>
    ) : (
      <span class="disabled"><Icon name={backArrow} size={16} />{prevPage}</span>
    )}
  </div>
  <div class="cluster">
    {nextHref ? (
      <a href={nextHref}>{nextPage}<Icon name={forwardArrow} size={16} /></a>
    ) : (
      <span class="disabled">{nextPage}<Icon name={forwardArrow} size={16} /></span>
    )}
  </div>
</nav>

<style>
  .pagination {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-4) 0;
  }

  .cluster a,
  .cluster .disabled {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text);
    font-size: var(--font-size-sm);
  }

  .cluster a:hover {
    background: var(--color-surface-hover);
    text-decoration: none;
  }

  .cluster .disabled {
    opacity: 0.5;
  }
</style>
