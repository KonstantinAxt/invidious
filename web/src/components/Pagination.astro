---
import { isRtl, translate } from '../lib/i18n'
import Icon from './icons/Icon.astro'

interface Props {
  locale: string
  /** Base URL with any query params the next/prev links must preserve.
      The component appends `&page=N` or `&continuation=…` to it. */
  baseUrl: string
  currentPage?: number
  hasNext: boolean
  continuationToken?: string
  /** Continuation (ctoken) mode only: link back to the first page. */
  firstPageHref?: string
}

const { locale, baseUrl, currentPage, hasNext, continuationToken, firstPageHref } = Astro.props
const rtl = isRtl(locale)

const [firstPage, prevPage, nextPage] = await Promise.all([
  translate(locale, 'First page'),
  translate(locale, 'Previous page'),
  translate(locale, 'Next page'),
])

const prevHref =
  currentPage !== undefined && currentPage > 1 ? `${baseUrl}&page=${currentPage - 1}` : null

let nextHref: string | null = null
if (hasNext) {
  if (currentPage !== undefined) {
    nextHref = `${baseUrl}&page=${currentPage + 1}`
  } else if (continuationToken) {
    nextHref = `${baseUrl}&continuation=${encodeURIComponent(continuationToken)}`
  }
}

const backArrow = rtl ? 'arrow-right' : 'arrow-left'
const forwardArrow = rtl ? 'arrow-left' : 'arrow-right'
---

{
  // Unavailable directions are hidden, not disabled (Invidious's classic
  // nav does the same); the whole nav disappears when nothing is clickable.
  (firstPageHref || prevHref || nextHref) && (
    <nav class="pagination">
      <div class="cluster">
        {firstPageHref ? (
          <a href={firstPageHref}><Icon name={backArrow} size={16} />{firstPage}</a>
        ) : prevHref ? (
          <a href={prevHref}><Icon name={backArrow} size={16} />{prevPage}</a>
        ) : null}
      </div>
      <div class="cluster">
        {nextHref ? (
          <a href={nextHref}>{nextPage}<Icon name={forwardArrow} size={16} /></a>
        ) : null}
      </div>
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-4) 0;
  }

  .cluster a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text);
    font-size: var(--font-size-sm);
  }

  .cluster a:hover {
    background: var(--color-surface-hover);
    text-decoration: none;
  }
</style>
