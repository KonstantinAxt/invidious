---
import { translate } from '../lib/i18n'
import Icon from './icons/Icon.astro'

interface Props {
  locale: string
  query?: string
}

const { locale, query = '' } = Astro.props
const placeholder = await translate(locale, 'search')
---

<search class="search-box">
  <form action="/search" method="get">
    <Icon name="search" size={24} />
    <input
      id="searchbox"
      type="search"
      name="q"
      value={query}
      placeholder={placeholder}
      autocomplete="off"
    />
    <span class="mic" aria-hidden="true"><Icon name="mic" size={24} /></span>
  </form>
</search>

<style>
  .search-box {
    flex: 1;
    max-width: 727px;
    height: 40px;
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-icon-muted);
  }

  form {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding-left: 15px;
  }

  .search-box:focus-within {
    border-color: var(--color-accent);
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-size: var(--font-size-title);
    outline: none;
  }

  input::placeholder {
    color: var(--color-text-placeholder);
    letter-spacing: -0.18px;
  }

  .mic {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 40px;
  }
</style>
