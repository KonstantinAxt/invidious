---
import type { Video } from '../../lib/api-types'
import { formatDuration, formatPremiere, formatPublished, formatViewCount } from '../../lib/format'
import { translate } from '../../lib/i18n'
import Icon from '../icons/Icon.astro'

interface Props {
  video: Video
  locale: string
  thumbnailSrc?: string
  avatarSrc?: string
  href?: string
}

const { video, locale, thumbnailSrc, avatarSrc, href } = Astro.props
const watchHref = href ?? `/watch?v=${video.videoId}`

const [duration, published, views, liveLabel] = await Promise.all([
  Promise.resolve(formatDuration(video.lengthSeconds)),
  video.isUpcoming
    ? formatPremiere(locale, video.published)
    : formatPublished(locale, video.published),
  formatViewCount(locale, video.viewCount),
  translate(locale, 'LIVE'),
])
---

<article class="video-card">
  <a class="thumb" href={watchHref} aria-label={video.title}>
    {thumbnailSrc && <img src={thumbnailSrc} alt="" loading="lazy" />}
    {video.liveNow ? (
      <span class="badge live">{liveLabel}</span>
    ) : (
      duration && <span class="badge">{duration}</span>
    )}
  </a>
  <div class="details">
    <a class="avatar" href={video.authorUrl} aria-label={video.author}>
      {avatarSrc && <img src={avatarSrc} alt="" loading="lazy" />}
    </a>
    <div class="info">
      <div class="title-row">
        <a class="title" href={watchHref}>{video.title}</a>
        <span class="more"><Icon name="more" size={24} /></span>
      </div>
      <div class="channel">
        <a href={video.authorUrl}>{video.author}</a>
        {video.authorVerified && <Icon name="check" size={16} />}
      </div>
      <p class="video-data">
        {views && `${views} • `}{published}
      </p>
    </div>
  </div>
</article>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-thumb);
    overflow: hidden;
    background: var(--color-surface);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 0 5px;
    border-radius: var(--radius-badge);
    background: var(--color-badge-bg);
    color: var(--color-badge-text);
    font-size: var(--font-size-md);
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.46px;
  }

  .badge.live {
    background: var(--color-live-gradient);
    letter-spacing: normal;
    font-weight: 500;
  }

  .details {
    display: flex;
    gap: var(--space-4);
  }

  .avatar {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    overflow: hidden;
    background: var(--color-surface);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    min-width: 0;
    flex: 1;
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .title {
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--color-text);
    font-size: var(--font-size-title);
    font-weight: 500;
    line-height: 25px;
  }

  .title:hover {
    text-decoration: none;
  }

  .more {
    flex-shrink: 0;
    color: var(--color-text-secondary);
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
  }

  .channel a {
    color: inherit;
  }

  .channel a:hover {
    color: var(--color-text);
  }

  .video-data {
    margin: 8px 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: 26.5px;
  }
</style>
