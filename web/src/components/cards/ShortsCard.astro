---
import type { Video } from '../../lib/api-types'
import { formatDuration, formatPublished, formatViewCount } from '../../lib/format'
import Icon from '../icons/Icon.astro'

interface Props {
  video: Video
  locale: string
  thumbnailSrc?: string
}

const { video, locale, thumbnailSrc } = Astro.props
const watchHref = `/watch?v=${video.videoId}`

const [duration, published, views] = await Promise.all([
  Promise.resolve(formatDuration(video.lengthSeconds)),
  formatPublished(locale, video.published),
  formatViewCount(locale, video.viewCount),
])
---

<article class="shorts-card">
  <a class="thumb" href={watchHref} aria-label={video.title}>
    {thumbnailSrc && <img src={thumbnailSrc} alt="" loading="lazy" />}
    {duration && <span class="badge">{duration}</span>}
    <span class="more"><Icon name="more" size={24} /></span>
  </a>
  <div class="meta">
    <a class="title" href={watchHref}>{video.title}</a>
    <a class="channel" href={video.authorUrl}>{video.author}</a>
    <p class="video-data">
      {views && `${views} • `}{published}
    </p>
  </div>
</article>

<style>
  /* Figma shorts rail card (92:14999): 231px wide, square-cornered 9:16 thumb,
     kebab overlay at top-right, title 18/25, channel + meta 16px. */
  .shorts-card {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .thumb {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: var(--color-thumb-bg);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 0 5px;
    border-radius: var(--radius-badge);
    background: var(--color-badge-bg);
    color: var(--color-badge-text);
    font-size: var(--font-size-md);
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.46px;
  }

  .more {
    position: absolute;
    top: 13.29px;
    right: 13px;
    z-index: 1;
    color: var(--color-badge-text);
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--color-text);
    font-size: var(--font-size-title);
    font-weight: 500;
    line-height: 25px;
  }

  .title:hover {
    text-decoration: none;
  }

  .channel {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
  }

  .channel:hover {
    color: var(--color-text);
  }

  .video-data {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: 26.5px;
  }
</style>
