---
import type { SearchChannelShape } from '../../lib/api-types'
import { translateCount } from '../../lib/i18n'
import Icon from '../icons/Icon.astro'

interface Props {
  channel: SearchChannelShape
  locale: string
  avatarSrc?: string
}

const { channel, locale, avatarSrc } = Astro.props

const [subs, vids] = await Promise.all([
  translateCount(locale, 'generic_subscribers_count', channel.subCount, 'short'),
  translateCount(locale, 'generic_videos_count', channel.videoCount, 'short'),
])
---

<article class="channel-card">
  <a class="avatar" href={channel.authorUrl}>
    {avatarSrc && <img src={avatarSrc} alt="" loading="lazy" />}
  </a>
  <div class="details">
    <a class="name" href={channel.authorUrl}>
      {channel.author}
      {channel.authorVerified && <Icon name="check" size={14} />}
    </a>
    {channel.channelHandle && <div class="handle">{channel.channelHandle}</div>}
    <div class="stats">{subs}</div>
    {!channel.autoGenerated && <div class="stats">{vids}</div>}
  </div>
</article>

<style>
  .channel-card {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .avatar {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-full);
    overflow: hidden;
    background: var(--color-surface);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .details {
    min-width: 0;
  }

  .name {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text);
    font-weight: 600;
  }

  .handle,
  .stats {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }
</style>
