---
import type { SearchPlaylistShape } from '../../lib/api-types'
import Icon from '../icons/Icon.astro'

interface Props {
  playlist: SearchPlaylistShape
  locale: string
  thumbnailSrc?: string
}

const { playlist, thumbnailSrc } = Astro.props
const href = playlist.playlistId.startsWith('RD')
  ? `/mix?list=${playlist.playlistId}`
  : `/playlist?list=${playlist.playlistId}`
---

<article class="playlist-card">
  <span class="bar bar-back" aria-hidden="true" />
  <span class="bar bar-front" aria-hidden="true" />
  <a class="thumb" href={href} aria-label={playlist.title}>
    {thumbnailSrc && <img src={thumbnailSrc} alt="" loading="lazy" />}
    <span class="badge">
      <Icon name="list" size={24} />
      {playlist.videoCount}
    </span>
  </a>
  {playlist.title && <span class="name-badge">{playlist.title}</span>}
</article>

<style>
  .playlist-card {
    position: relative;
  }

  .bar {
    position: absolute;
    top: -14px;
    height: 5px;
    border-radius: 20px 20px 0 0;
    pointer-events: none;
  }

  .bar-back {
    left: 8%;
    width: 84%;
    background: #33141e;
  }

  .bar-front {
    top: -7px;
    left: 4.5%;
    width: 91%;
    background: #5d0e27;
  }

  .thumb {
    position: relative;
    z-index: 1;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-thumb);
    overflow: hidden;
    background: var(--color-surface);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 2px 8px 2px 12px;
    border-radius: var(--radius-badge);
    background: var(--color-badge-bg);
    color: var(--color-badge-text);
    font-size: var(--font-size-md);
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.46px;
  }

  .name-badge {
    position: absolute;
    z-index: 2;
    left: 10px;
    bottom: 10px;
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0 8px 0 12px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-badge);
    background: var(--color-badge-bg);
    color: var(--color-badge-text);
    font-size: var(--font-size-md);
    font-weight: 500;
    letter-spacing: 0.46px;
  }
</style>
