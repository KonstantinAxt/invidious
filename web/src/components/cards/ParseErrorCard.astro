---
import { translate } from '../../lib/i18n'
import Icon from '../icons/Icon.astro'

interface Props {
  locale: string
  message?: string | null
}

const { locale, message } = Astro.props

const [heading, placeholder] = await Promise.all([
  translate(locale, 'timeline_parse_error_placeholder_heading'),
  translate(locale, 'timeline_parse_error_placeholder_message'),
])
---

<article class="parse-error-card">
  <Icon name="alert" size={24} />
  <h3 class="heading">{heading}</h3>
  <p class="message">{message ?? placeholder}</p>
</article>

<style>
  .parse-error-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--color-error-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    text-align: center;
  }

  .heading {
    margin: 0;
    font-size: var(--font-size-md);
  }

  .message {
    margin: 0;
    font-size: var(--font-size-sm);
  }
</style>
