---
import type { CommunityPost } from '../lib/api-types'
import { shortNumber } from '../lib/numbers'
import Icon from './icons/Icon.astro'

interface Props {
  post: CommunityPost
}

const { post } = Astro.props
---

<article class="post-card">
  <div class="top">
    {post.contentHtml && <div class="content" set:html={post.contentHtml} />}
    <span class="more"><Icon name="more" size={24} /></span>
  </div>
  <span class="time">{post.publishedText}</span>
  <div class="reactions">
    <span class="pill like-pill">
      <Icon name="like" size={24} />
      {post.likeCount > 0 && <span class="count">{shortNumber(post.likeCount)}</span>}
      <span class="divider" />
      <Icon name="dislike" size={24} />
    </span>
    <span class="pill">
      <Icon name="reply" size={24} />
      {post.replyCount > 0 && <span class="count">{shortNumber(post.replyCount)}</span>}
      <span class="divider" />
      <Icon name="share" size={24} />
    </span>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    min-height: 289px;
    padding: 16px;
    border: 1px solid var(--color-border-panel);
    border-radius: 16px;
  }

  .top {
    display: flex;
    gap: 8px;
  }

  .content {
    flex: 1;
    min-width: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--color-text);
    font-size: var(--font-size-title);
    font-weight: 500;
    line-height: 25px;
  }

  .content :global(a) {
    color: var(--color-link);
  }

  .more {
    flex-shrink: 0;
    color: var(--color-text-secondary);
  }

  .time {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: 26.5px;
  }

  .reactions {
    display: flex;
    gap: 8px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    height: 32px;
    padding: 0 16px;
    border-radius: 100px;
    background: var(--color-fill-button);
    color: var(--color-text);
    font-size: var(--font-size-sm);
  }

  .like-pill {
    padding: 0 10px 0 14px;
  }

  .count {
    font-size: var(--font-size-sm);
  }

  .divider {
    width: 1.286px;
    height: 28px;
    background: var(--color-border-hairline);
  }
</style>
