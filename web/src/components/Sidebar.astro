---
import { translate } from '../lib/i18n'
import { ROUTES } from '../lib/routes'
import Icon from './icons/Icon.astro'

interface SidebarItem {
  labelKey: string
  icon: string
  href?: string
  /** TBD (phase 2, auth): not ported yet — rendered muted, no link. */
  tbd?: boolean
}

interface Props {
  locale: string
  activeHref?: string
  groups?: SidebarItem[][]
}

const { locale, activeHref = '/', groups } = Astro.props

const defaultGroups: SidebarItem[][] = [
  [
    { labelKey: 'Home', icon: 'home', href: ROUTES.home },
    { labelKey: 'Search', icon: 'search', href: ROUTES.search },
    { labelKey: 'Trending', icon: 'trending', href: ROUTES.trendingFeed },
    { labelKey: 'Popular', icon: 'eye', href: ROUTES.popularFeed },
  ],
  // TBD (phase 2, auth): add the href once the pages are ported.
  [
    { labelKey: 'History', icon: 'history', tbd: true },
    { labelKey: 'Watch later', icon: 'clock', tbd: true },
    { labelKey: 'Liked videos', icon: 'heart', tbd: true },
    { labelKey: 'Playlists', icon: 'list', tbd: true },
  ],
  // TBD (phase 2, auth), like the design's third group.
  [
    { labelKey: 'Collections', icon: 'collections', tbd: true },
    { labelKey: 'Subscriptions', icon: 'rss', tbd: true },
  ],
]

const resolved = groups ?? defaultGroups
const labelMap = new Map<string, string>()
const [soonLabel] = await Promise.all([
  translate(locale, 'Coming soon'),
  ...[...new Set(resolved.flat().map((item) => item.labelKey))].map(async (key) => {
    labelMap.set(key, await translate(locale, key))
  }),
])
---

<nav class="sidebar" id="app-sidebar">
  {
    resolved.map((group, groupIndex) => (
      <Fragment>
        {groupIndex > 0 && <hr class="sidebar-divider" />}
        <ul>
          {
            group.map((item) => {
              const active = item.href != null && item.href === activeHref
              return (
                <li>
                  {item.href != null ? (
                    <a
                      href={item.href}
                      class:list={['sidebar-item', { active }]}
                      aria-current={active ? 'page' : undefined}
                    >
                      <Icon name={item.icon} size={24} />
                      <span>{labelMap.get(item.labelKey)}</span>
                    </a>
                  ) : (
                    <span class="sidebar-item tbd" title={soonLabel}>
                      <Icon name={item.icon} size={24} />
                      <span>{labelMap.get(item.labelKey)}</span>
                    </span>
                  )}
                </li>
              )
            })
          }
        </ul>
      </Fragment>
    ))
  }
</nav>

<style>
  .sidebar {
    position: sticky;
    top: var(--navbar-height);
    align-self: start;
    /* Icons land at x82, aligned with the navbar's 82px content edge. */
    margin-inline-start: var(--sidebar-offset);
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: var(--sidebar-width);
    height: calc(100vh - var(--navbar-height));
    padding: 11px;
    overflow-y: auto;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Hairline between groups, like the design's white 15% lines. */
  .sidebar-divider {
    width: 100%;
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--color-divider);
  }

  li {
    position: relative;
  }

  .sidebar-item {
    position: relative;
    z-index: 0;
    display: flex;
    align-items: center;
    gap: 20px;
    height: 24px;
    color: var(--color-text);
    font-size: 17px;
    font-weight: 500;
    line-height: 23.9px;
  }

  /* Full-width active pill (Figma: 45px tall, radius 10, pink 14%). */
  .sidebar-item::before {
    content: '';
    position: absolute;
    left: -11px;
    right: -11px;
    top: 50%;
    transform: translateY(-50%);
    height: 45px;
    border-radius: 10px;
    z-index: -1;
  }

  .sidebar-item:hover {
    text-decoration: none;
  }

  .sidebar-item:hover::before {
    background: var(--color-surface-hover);
  }

  .sidebar-item.active::before {
    background: var(--color-accent-fill);
  }

  /* TBD items: visible, muted, no link affordance. */
  .sidebar-item.tbd {
    color: var(--color-text-tertiary);
    cursor: default;
  }

  .sidebar-item.tbd:hover::before {
    background: transparent;
  }

  @media (max-width: 900px) {
    .sidebar {
      display: none;
    }

    /* Drawer opened by the navbar menu button (html.sidebar-open). */
    :global(html.sidebar-open) .sidebar {
      display: flex;
      /* align-self must not be `start` here: on a fixed element it collapses
         the auto-height stretch (inset) to the content height in Chromium. */
      align-self: auto;
      margin-inline-start: 0;
      position: fixed;
      top: var(--navbar-height);
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 5;
      width: auto;
      height: auto;
      padding: var(--space-4) var(--space-5);
      background: var(--color-bg);
    }
  }
</style>
