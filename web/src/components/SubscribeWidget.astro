---
import { translate } from '../lib/i18n'

interface Props {
  locale: string
  ucid: string
  subCountText: string
  referer?: string
}

const { locale, ucid, subCountText, referer } = Astro.props
const label = await translate(locale, 'Subscribe')
const href = `/login?referer=${encodeURIComponent(referer ?? `/channel/${ucid}`)}`
---

<a class="subscribe-widget" href={href}>
  {label}
  {subCountText && <span class="count">{subCountText}</span>}
</a>

<style>
  .subscribe-widget {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 40px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-button);
    background: var(--color-accent-button);
    color: #ffffff;
    font-weight: 500;
    font-size: var(--font-size-md);
  }

  .count {
    opacity: 0.85;
    font-weight: 400;
    font-size: var(--font-size-sm);
  }
</style>
