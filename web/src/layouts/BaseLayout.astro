---
import Footer from '../components/Footer.astro'
import Navbar from '../components/Navbar.astro'
import Sidebar from '../components/Sidebar.astro'
import { DEFAULT_LOCALE, isRtl } from '../lib/i18n'
import '../styles/base.css'
import '../styles/tokens.css'

interface Props {
  title: string
  locale?: string
  description?: string
  showSearch?: boolean
  showSidebar?: boolean
  activeHref?: string
  query?: string
}

const {
  title,
  locale = DEFAULT_LOCALE,
  description,
  showSearch = true,
  showSidebar = true,
  activeHref,
  query,
} = Astro.props
const dir = isRtl(locale) ? 'rtl' : 'ltr'
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>{title} — Invidious</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Navbar locale={locale} query={query} showSearch={showSearch} />
    <div class="app-shell">
      {showSidebar && <Sidebar locale={locale} activeHref={activeHref} />}
      <main class="app-main">
        <slot />
        <Footer locale={locale} />
      </main>
    </div>
  </body>
</html>

<style>
  /* Home frame (Figma 4:11081): sidebar at x71, content column x369..1838. */
  .app-shell {
    display: grid;
    grid-template-columns: calc(var(--sidebar-width) + var(--sidebar-offset)) minmax(0, 1fr);
  }

  .app-main {
    min-width: 0;
    max-width: var(--content-max-width);
    margin-inline: var(--content-gap) var(--page-margin);
  }

  @media (max-width: 900px) {
    .app-shell {
      display: block;
    }

    .app-main {
      max-width: none;
      margin-inline: 0;
      padding-inline: var(--space-4);
    }
  }
</style>
