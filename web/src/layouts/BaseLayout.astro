---
import Footer from '../components/Footer.astro'
import Navbar from '../components/Navbar.astro'
import { DEFAULT_LOCALE, isRtl } from '../lib/i18n'
import '../styles/base.css'
import '../styles/tokens.css'

interface Props {
  title: string
  locale?: string
  description?: string
  showSearch?: boolean
  query?: string
}

const { title, locale = DEFAULT_LOCALE, description, showSearch = true, query } = Astro.props
const dir = isRtl(locale) ? 'rtl' : 'ltr'
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>{title} — Invidious</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Navbar locale={locale} query={query} showSearch={showSearch} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>
