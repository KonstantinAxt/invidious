---
import ChipsRow from '../components/ChipsRow.astro'
import FeedSection from '../components/FeedSection.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { resolveFeed } from '../lib/feed'
import { detectLocale, translate } from '../lib/i18n'

const locale = detectLocale(Astro.request.headers.get('accept-language'))
const [title, allLabel, musicLabel, gamingLabel, moviesLabel, liveLabel, newsLabel] =
  await Promise.all([
    translate(locale, 'Trending'),
    translate(locale, 'All'),
    translate(locale, 'Music'),
    translate(locale, 'Gaming'),
    translate(locale, 'Movies'),
    translate(locale, 'Live'),
    translate(locale, 'News'),
  ])

const { items } = await resolveFeed('trending')
---

<BaseLayout title={title} locale={locale} activeHref="/">
  <ChipsRow
    chips={[
      { label: allLabel, selected: true },
      { label: musicLabel },
      { label: gamingLabel },
      { label: moviesLabel },
      { label: liveLabel },
      { label: newsLabel },
    ]}
  />
  <FeedSection title={title} locale={locale} items={items} variant="hero" />
</BaseLayout>
